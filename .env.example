# --- Operator (cmd/operator) ---
# eBPF attach settings are NOT env vars -- they're CLI flags instead
# (--bpf-object, default /var/run/sentinel5g/packet_filter.o; --bpf-interface,
# default eth0), since the Helm chart renders them as container args rather
# than env vars. Not listed below for that reason, not because they don't exist.
LOG_LEVEL=info
METRICS_BIND_ADDRESS=:8080
HEALTH_PROBE_BIND_ADDRESS=:8081
LEADER_ELECT=false

# NATS JetStream connection shared by the operator and the AI engine
NATS_URL=nats://localhost:4222
NATS_EVENTS_SUBJECT=sentinel5g.events.normalized
NATS_THREATS_SUBJECT=sentinel5g.threats.scored
NATS_STREAM_NAME=SENTINEL5G

# NATS auth/TLS — all optional, empty by default. Anything that can reach an
# unauthenticated NATS_URL can forge a ThreatScoreEvent and trigger a real
# mitigation, so set at least one of these outside of local dev.
# NATS_CREDENTIALS_FILE (an NKey/JWT .creds file) takes precedence over
# NATS_USERNAME/NATS_PASSWORD if both are set.
NATS_CREDENTIALS_FILE=
NATS_USERNAME=
NATS_PASSWORD=
NATS_TLS_CA_FILE=
NATS_TLS_CERT_FILE=
NATS_TLS_KEY_FILE=
# Both the operator and the AI engine refuse to start (or, for the AI
# engine, refuse AI_ENGINE_MODE=nats specifically) against a NATS bus with
# none of the fields above set, unless this is explicitly true. Set to true
# for local dev against the docker-compose/quickstart NATS, which has no
# auth configured -- leave unset (false) anywhere else. See
# docs/integrations.md's "Securing the NATS message bus".
NATS_ALLOW_UNAUTHENTICATED=

# Threshold (0.0-1.0) above which a ThreatScoreEvent triggers auto-mitigation
THREAT_SCORE_THRESHOLD=0.85

# Service mesh adapter used for quarantine actions: "istio", "cilium",
# "linkerd", or "noop". Linkerd's guarantee is weaker than the other two --
# see docs/integrations.md.
MESH_ADAPTER=istio

# Cilium-native capture path (pkg/hubble.Observer): an alternative to eBPF's
# own standalone XDP attach (--bpf-object/--bpf-interface above), not
# additive to it -- see docs/integrations.md's "Capture layer" section.
# Empty (the default) disables this entirely. Set to a Hubble Observer gRPC
# endpoint (typically Hubble Relay) to enable it, e.g.
# "hubble-relay.kube-system.svc.cluster.local:80".
HUBBLE_ADDR=
# Hubble Relay is commonly deployed with mTLS -- all optional and empty by
# default (plaintext), matching HUBBLE_ADDR's own disabled-by-default
# posture. See
# https://docs.cilium.io/en/stable/observability/hubble/configuration/#tls-configuration.
HUBBLE_TLS_CA_FILE=
HUBBLE_TLS_CERT_FILE=
HUBBLE_TLS_KEY_FILE=

# How long a TelecomSecurityPolicy must go without a new mitigation before
# the operator automatically reverses its active ones (eBPF unblock, mesh
# release) — a Go duration string. See pkg/controller.Reconciler's
# tryDeEscalate for why this is a quiet-period timer, not a "wait for a
# sustained low score" one.
DE_ESCALATION_DWELL=5m

# How long after startup the operator waits before reporting
# ScoringPipelineReady=False on every TelecomSecurityPolicy -- a Go duration
# string. The AI engine (cmd/ai-engine) is deployed separately and needs a
# trained model; if that step is skipped nothing ever publishes a score and
# every policy sits at Phase: Monitoring forever, which looks exactly like a
# healthy, quiet cluster. This grace period only covers the window where "no
# score yet" is still expected, e.g. an install where the AI engine comes up
# after the operator. See pkg/controller/scoring_pipeline.go.
SCORING_PIPELINE_GRACE=10m

# --- Deterministic GTP-U tunnel-flood detector (pkg/detect) ---
# A non-ML rule, running alongside the AI engine rather than inside it. It
# exists because the autoencoder provably cannot catch this class: measured
# against real GTP-U from a live Open5GS/UERANSIM core, an in-tunnel flood
# scored 0.0679 -- BELOW the 0.0811 normal baseline -- so no threshold on the
# model's score separates them (docs/paper-data/02-ai-training-inference.md
# §2.4-§2.6). On by default; it still goes through full policy gating, so a policy
# with autoMitigate: false only ever reaches Phase: Alerting.
GTPU_TUNNEL_FLOOD_ENABLED=true

# Packets per second on a SINGLE GTP-U tunnel (one TEID) -- not per source
# IP, which on a real N3 aggregates every subscriber behind the peer gNB's
# address and is exactly what hides a single-tunnel flood.
#
# Reasoned, not empirically tuned against a production N3 interface. The
# lab tunnel sustains ~125,000 pkt/s from a real generator
# (docs/paper-data/test-environment.md), so 1000 is reachable by an
# attacker by orders of magnitude -- conservative, not unreachable -- and
# the real captures show 0 normal packets anywhere near it. Same honesty
# caveat as bpf/headers/common.h's SCAN_EMIT_THRESHOLD; the number for your
# network comes from a detection-only pilot (docs/production-install.md).
GTPU_TUNNEL_FLOOD_PPS=1000

# Minimum interval between events for one (source IP, TEID) -- a cost
# control, so a sustained flood doesn't publish thousands of identical scores
# per second. Not what makes the pipeline safe under duplicate delivery;
# that's the mitigation path's own idempotency.
GTPU_TUNNEL_FLOOD_COOLDOWN=30s

# --- Falco bridge (cmd/falco-bridge) ---
# A separate binary from the operator -- translates Falco's own JSON
# http_output alerts into NormalizedEvents on the same NATS_* bus above (it
# reuses NATS_URL/NATS_EVENTS_SUBJECT/etc. from the shared block above, not
# its own copies). See docs/integrations.md's Falco section.
FALCO_BRIDGE_LISTEN_ADDR=:8091
# Falco's http_output posts unauthenticated by default -- set this (and
# configure Falco's own http_output.headers with a matching
# X-Sentinel5g-Shared-Secret value) if the bridge is reachable by anything
# other than Falco itself. Empty by default, matching local dev.
FALCO_BRIDGE_SHARED_SECRET=
# Only used as a fallback when a given Falco alert's own "hostname" field is
# empty -- normally left unset (falco-bridge defaults to os.Hostname()).
NODE_NAME=

# --- AI engine (cmd/ai-engine) ---
AI_ENGINE_HTTP_ADDR=0.0.0.0:8090
AI_ENGINE_MODE=http
# Produce one with `make ai-engine-train-real` (the committed real captures)
# or pull the published artifact -- see charts/sentinel5g-ai-engine. A model
# exported against a different feature vector is refused at startup, with
# the re-export command in the error.
MODEL_PATH=./models/autoencoder.onnx
# Informational: the vector's width is fixed by sentinel_ai/features.py's
# FEATURE_NAMES (12 -- docs/event-model.md lists them), not by this setting.
FEATURE_VECTOR_SIZE=12
# Only used in AI_ENGINE_MODE=nats: HTTP mode already exposes /metrics on
# AI_ENGINE_HTTP_ADDR via prometheus_fastapi_instrumentator, since it already
# has an app; the NATS worker has no HTTP server of its own, so it starts a
# small dedicated one here instead (see sentinel_ai/server.py's main()).
AI_ENGINE_METRICS_ADDR=0.0.0.0:9090
