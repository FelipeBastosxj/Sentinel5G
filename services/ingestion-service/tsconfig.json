{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "types": ["node", "jest"],
    "paths": {
      "@eventstream/contracts": ["../../shared/contracts/src"],
      "@eventstream/contracts/*": ["../../shared/contracts/src/*"],
      "@eventstream/schemas": ["../../shared/schemas/src"],
      "@eventstream/schemas/*": ["../../shared/schemas/src/*"],
      "@eventstream/utils": ["../../shared/utils/src"],
      "@eventstream/utils/*": ["../../shared/utils/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
