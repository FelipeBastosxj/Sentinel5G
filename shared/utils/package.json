{
  "name": "@telecom-webhook/utils",
  "version": "0.1.0",
  "private": true,
  "description": "Shared utility functions and helpers for the Open Telecom Webhook Observability platform.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@eventstream/contracts": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.2",
    "@types/node": "^20.11.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@eventstream/contracts(|/.*)$": "<rootDir>/../../contracts/src$1"
    }
  }
}
